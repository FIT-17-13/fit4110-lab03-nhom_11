    },
    {
      "name": "06_Local_only_NonFunctional",
      "item": [
        {
          "name": "GET /health - local response time SLA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Latency test: chỉ chạy và đánh giá trên service thật"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const env = pm.environment.get('env') || 'mock';",
                  "if (env === 'local') {",
                  "  pm.test('Local service responds under 200ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(200);",
                  "  });",
                  "} else {",
                  "  pm.test('Skipped on mock: mock latency is ignored', function () {",
                  "    pm.expect(true).to.eql(true);",
